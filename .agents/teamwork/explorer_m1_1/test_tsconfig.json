{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "../../backend",
    "outDir": "../../backend/dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "express"],
    "typeRoots": ["../../backend/node_modules/@types"]
  },
  "include": ["../../backend/src/**/*", "../../backend/prisma/**/*"],
  "exclude": ["../../backend/node_modules", "../../backend/dist", "../../backend/api"]
}
